<Window x:Class="Stock.Desktop.OcrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:q="clr-namespace:Stock.Desktop.Controls"
 Style="{StaticResource {x:Type Window}}" Title="货单照片识别与核对" Width="1360" Height="900" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="Dropped" DragOver="Dragged">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#688276"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FieldValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style x:Key="OriginalValue" TargetType="TextBox" BasedOn="{StaticResource FieldValue}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="Background" Value="#F3F7F5"/></Style>
 </Window.Resources>
 <DockPanel x:Name="Root" Margin="22">
  <StackPanel x:Name="Toolbar" DockPanel.Dock="Top">
   <TextBlock Text="选好照片 → 识别货单 → 核对货品和数量" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <WrapPanel Margin="0,0,0,10"><Button Content="选择照片" Click="Choose"/><Button Content="摄像头拍照" Click="Camera"/><Button Content="向左旋转" Click="RotateLeft"/><Button Content="向右旋转" Click="RotateRight"/><Button Content="检测表格" Click="AutoTable"/><Button Content="调整四角" Click="SelectCorners"/><Button Content="应用四角" Click="ApplyCorners"/><Button Content="框选裁剪" Click="EnableCrop"/><Button Content="恢复原图" Click="Reset"/></WrapPanel>
   <WrapPanel Margin="0,0,0,12"><CheckBox x:Name="UploadConfirm" Content="已检查截图，只包含表头、货品和合计，允许上传识别"/><CheckBox x:Name="Offline" Content="使用本机识别（不用联网）" Margin="18,0"/><TextBlock Text="缩放" VerticalAlignment="Center"/><Slider x:Name="Zoom" Minimum="0.1" Maximum="2.5" Value="0.5" Width="130" ValueChanged="Zoomed"/></WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><TextBlock x:Name="StatusText" Text="选择或拖入一张JPG / PNG照片，先在本机裁剪并确认范围。" TextWrapping="Wrap"/></ScrollViewer>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="RecognizeButton" Content="识别确认的截图" Style="{StaticResource Primary}" Click="Recognize"/><Button x:Name="CancelOcrButton" Content="取消识别" Click="CancelOcr" Visibility="Collapsed"/><Button Content="关闭" Click="CloseWindow"/><Button x:Name="AddRowsButton" Content="加入进货清单" Click="AddRows"/></WrapPanel>
  </StackPanel>
  <Grid x:Name="ContentGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <Border Background="#E5ECE8" CornerRadius="6"><ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="CropStart" MouseMove="CropMove" MouseLeftButtonUp="CropEnd" LostMouseCapture="CropCaptureLost"><Image x:Name="PhotoImage" Stretch="Uniform"/><Canvas x:Name="Overlay" IsHitTestVisible="False"><Polygon x:Name="CornerOutline" Stroke="#E58B34" StrokeThickness="3" Fill="#20E58B34" Visibility="Collapsed"/><Rectangle x:Name="Selection" Stroke="#E58B34" StrokeThickness="2" Fill="#30E58B34" Visibility="Collapsed"/><Rectangle x:Name="RowHighlight" Stroke="#087F73" StrokeThickness="3" Fill="#20087F73" Visibility="Collapsed"/></Canvas></Grid></ScrollViewer></Border>
   <DockPanel x:Name="ReviewPanel" Grid.Column="2">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="核对货品和数量，填写完成后加入清单" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8"><StackPanel>
      <TextBlock x:Name="ResultSummaryText" Text="识别后，在这里检查每行货品和本次进货数量。" TextWrapping="Wrap"/>
      <ItemsControl x:Name="SectionTotalsList" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="ResultWarningsText" TextWrapping="Wrap" Foreground="#A95A15" Margin="0,6,0,0"/>
     </StackPanel></ScrollViewer>
     <ComboBox x:Name="ColumnPicker" DisplayMemberPath="Label" SelectionChanged="ColumnChanged" Margin="0,0,0,8" ToolTip="请选择照片上写着“实发”的数量列"/>
     <WrapPanel><Button Content="补充一行" Click="AddManualRow"/><Button Content="查看未填完整的行" Click="NextProblem"/></WrapPanel>
     <Expander x:Name="TotalCorrectionPanel" Header="数量说明（可留空）" Margin="0,0,0,8"><StackPanel><TextBlock Text="照片合计仅供对照。入库使用当前清单数量，需要时可备注原因。" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TotalOverride" TextWrapping="Wrap" ToolTip="例如：照片合计写成10，逐行核实应为12"/></StackPanel></Expander>
     <Expander Header="技术详情" Margin="0,0,0,8"><TextBlock x:Name="TechnicalDetails" Text="识别后可查看耗时和用量。" TextWrapping="Wrap"/></Expander>
    </StackPanel>
    <ScrollViewer x:Name="ReviewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="ReviewRows" ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="White" BorderBrush="#D5E2DE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"><StackPanel>
       <TextBlock Text="选择已有货品，或新建货品" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <ComboBox x:Name="ExistingProduct" ItemsSource="{Binding Products}" SelectedItem="{Binding Product,Mode=OneWay}" SelectionChanged="ProductSelected" DisplayMemberPath="Display" Margin="0,0,0,8"/>
       <WrapPanel Margin="0,0,0,10"><Button x:Name="SearchExistingProduct" Content="搜索已有货品" Tag="{Binding}" Click="Associate" Padding="10,5"/><Button Content="新建货品" Tag="{Binding}" Click="NewProduct" Padding="10,5"/></WrapPanel>
       <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="货品名称" Style="{StaticResource FieldLabel}"/><q:ProductTermBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" TermField="Name" Service="{Binding Stock,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TermSelected="TermPicked"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="货品编码" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProductCode" Text="{Binding MaterialCode,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldValue}"/></StackPanel>
       </Grid>
       <TextBlock Text="规格 / 型号" Style="{StaticResource FieldLabel}"/><q:ProductTermBox Text="{Binding Spec,UpdateSourceTrigger=PropertyChanged}" TermField="Spec" MaxLength="500" Service="{Binding Stock,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" AcceptsReturn="True" TermSelected="TermPicked" Margin="0,0,0,8"/>
       <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/><q:ProductTermBox Text="{Binding Color,UpdateSourceTrigger=PropertyChanged}" TermField="Color" Service="{Binding Stock,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TermSelected="TermPicked" ToolTip="电池、充电器必须为空"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="货品类型" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductTypePicker" ItemsSource="{Binding TypeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       </Grid>
       <Border Background="#EAF5F1" Padding="12" CornerRadius="5" Margin="0,0,0,10"><StackPanel>
        <TextBlock Text="本次进货数量" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <DockPanel><TextBlock Text="{Binding Unit}" DockPanel.Dock="Right" FontSize="17" VerticalAlignment="Center" Margin="12,0,0,0"/><q:QuantityBox x:Name="ActualQuantity" Minimum="0" Value="{Binding Quantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock Text="点数字直接修改，也可以点－或＋。最终确认入库时，以这里的数量为准。" TextWrapping="Wrap" Margin="0,8,0,6"/>
        <TextBlock Text="照片识别的数量（只供对照）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawQuantity,Mode=OneWay}" Style="{StaticResource OriginalValue}"/>
        <TextBlock Text="{Binding QuantityColumnHelp}" TextWrapping="Wrap" Foreground="#688276" Margin="0,5,0,0"/>
       </StackPanel></Border>
       <TextBlock Text="照片单位（识别不准时可修改）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="InvoiceUnit" Text="{Binding RawUnit,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldValue}"/>
       <TextBlock Text="{Binding RawUnitHelp}" TextWrapping="Wrap" Margin="0,5,0,8"/>
       <CheckBox x:Name="ConfirmUnit" IsChecked="{Binding UnitConfirmed,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding UnitConfirmationRequired,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"><TextBlock Text="{Binding UnitConfirmationText}" TextWrapping="Wrap"/></CheckBox>
       <TextBlock Text="标记 / 备注（可留空）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Marker,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"/>
       <TextBlock Text="{Binding ReviewStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Warning}" Foreground="#A95A15" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <WrapPanel><CheckBox x:Name="ReviewedCheck" Content="已核对" ToolTip="可选标记，方便记住检查过的行；不勾选也可以加入清单。" IsChecked="{Binding Reviewed,Mode=OneWay}" Click="ReviewClicked" Margin="0,0,12,8"/><Button Content="移除此行" Tag="{Binding}" Click="RemoveRow" Padding="10,5" Margin="0,0,8,8"/><Button Content="在照片中查找（另行付费）" Tag="{Binding}" Click="Locate" Padding="8,5" Margin="0,0,8,8"/></WrapPanel>
       <Expander Header="照片识别原文（点击展开对照）" IsExpanded="False" Margin="0,8,0,10"><StackPanel Margin="0,8,0,0">
        <TextBlock Text="照片行号" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OriginalOrder,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="照片上的货品名称（含括号编码）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawName,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="照片原规格 / 型号" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceSpec,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="照片原颜色" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceColor,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="照片原编码" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceCode,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="识别出的货品类型" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceType,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="照片原单位（保留识别结果）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SourceRawUnit,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="判断货品类型时参考的原文" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SectionEvidence,Mode=OneWay}" Style="{StaticResource OriginalValue}" Margin="0,0,0,6"/>
        <TextBlock Text="识别时发现的问题（请对照照片检查）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RecognitionIssues,Mode=OneWay}" Style="{StaticResource OriginalValue}"/>
       </StackPanel></Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
