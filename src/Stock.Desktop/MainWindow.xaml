<Window x:Class="Stock.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Stock.Presentation" Style="{StaticResource {x:Type Window}}" Title="本地库存管理" Width="1280" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="20,18">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地库存管理" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="库存、进出货与货单记录" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Content="设置与备份" p:Presentation.Icon="{StaticResource SettingsIcon}" Click="Settings" VerticalAlignment="Center" Margin="0"/></Grid>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource SelectedSurface}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/></DockPanel></Border>
  <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
   <TabItem Header="库存首页"><DockPanel Margin="12,16">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"><StackPanel>
     <WrapPanel Margin="0,0,0,6"><TextBlock Text="搜索库存" VerticalAlignment="Center" Margin="0,0,10,6"/><TextBox Width="270" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、规格或物料编码搜索" Margin="0,0,12,6"/><CheckBox Content="显示停用货品" IsChecked="{Binding IncludeInactive}" Margin="0,0,12,6"/></WrapPanel>
     <WrapPanel><Button Content="新增货品" Style="{StaticResource Primary}" p:Presentation.Icon="{StaticResource PlusIcon}" Click="CreateProduct"/><Button Content="组合筛选" p:Presentation.Icon="{StaticResource SearchIcon}" Click="InventoryFilter"/><Button Content="分类汇总" Click="InventorySummary"/><Button Content="导出库存" p:Presentation.Icon="{StaticResource ExportIcon}" Click="InventoryExport"/><Button Content="刷新" p:Presentation.Icon="{StaticResource RefreshIcon}" Click="Refresh"/></WrapPanel>
    </StackPanel></Border>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="上一页" Style="{StaticResource CompactButton}" Click="PreviousProducts"/><Button Content="下一页" Style="{StaticResource CompactButton}" Click="NextProducts"/></WrapPanel><TextBlock Text="{Binding ProductPageText}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="进货增加仓库数量，出货扣减仓库数量。点击“编辑”可以修改货品资料。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <Grid><DataGrid ItemsSource="{Binding Products}" x:Name="InventoryGrid"><DataGrid.Columns>
     <DataGridTextColumn Header="货品名称" Binding="{Binding Name}" Width="*" MinWidth="110" MaxWidth="180" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="3*" MinWidth="240" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="72" MinWidth="72" ElementStyle="{StaticResource CellCentered}"/>
     <DataGridTextColumn Header="颜色" Binding="{Binding ColorText}" Width="1.5*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="物料编码" Binding="{Binding MaterialCode}" Width="110" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
     <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="56" MinWidth="56" ElementStyle="{StaticResource CellCentered}"/>
     <DataGridTextColumn Header="店面" Binding="{Binding Store}" Width="SizeToCells" MinWidth="72" ElementStyle="{StaticResource CellNumber}"/>
     <DataGridTextColumn Header="仓库" Binding="{Binding Warehouse}" Width="SizeToCells" MinWidth="72" ElementStyle="{StaticResource CellNumber}"/>
     <DataGridTextColumn Header="合计" Binding="{Binding Total}" Width="SizeToCells" MinWidth="72" ElementStyle="{StaticResource CellNumber}"/>
     <DataGridTemplateColumn Header="操作" Width="152" MinWidth="152"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="调整分布" Tag="{Binding}" Style="{StaticResource CompactButton}" Click="Transfer"/><Button Content="编辑" Tag="{Binding}" Style="{StaticResource CompactButton}" Margin="0" Click="EditProduct"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid><TextBlock Text="还没有货品。点击“新增货品”录入名称、规格与期初库存。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Products.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   </DockPanel></TabItem>
   <TabItem Header="进货"><StackPanel Margin="30,36"><TextBlock Text="厂家进货" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="手动添加货品，或导入货单照片。核对清单并最终确认后，数量增加到仓库。" TextWrapping="Wrap" Margin="0,14,0,26"/><WrapPanel><Button Content="手动进货" p:Presentation.Icon="{StaticResource PlusIcon}" Style="{StaticResource Primary}" Click="Purchase"/><Button Content="照片识别进货" p:Presentation.Icon="{StaticResource PhotoIcon}" Click="PhotoPurchase"/></WrapPanel><Border Style="{StaticResource Card}" Padding="22" Margin="0,28,0,0"><StackPanel><TextBlock Text="货单照片使用步骤" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="1. 将手机照片复制到电脑，或使用电脑摄像头拍照。&#xA;2. 检查提示的内容，按需修改“本次进货数量”。&#xA;3. 加入清单，查看库存变化，再点击“确认入库”。" LineHeight="30" Margin="0,12,0,0"/><TextBlock Text="联网识别会上传你确认的表格截图，并由所选识别服务收取费用。手动填单可以断网使用。" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></TabItem>
   <TabItem Header="出货"><StackPanel Margin="30,36"><TextBlock Text="零售与批发出货" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="选择出货渠道，手动添加货品并核对数量。最终确认后，只从仓库扣减。" TextWrapping="Wrap" Margin="0,14,0,26"/><Button Content="新增出货单" p:Presentation.Icon="{StaticResource PlusIcon}" Style="{StaticResource Primary}" Click="Sale" HorizontalAlignment="Left"/><Border Style="{StaticResource Card}" Padding="22" Margin="0,28,0,0"><TextBlock Text="仓库数量不够时，先到库存首页点“调整分布”，把店面的货调回仓库，再填写出货单。" TextWrapping="Wrap"/></Border></StackPanel></TabItem>
   <TabItem Header="记录查询"><DockPanel Margin="12,16">
    <StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,0,0,12"><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="140" Margin="0,0,12,8"/><DatePicker SelectedDate="{Binding Start}" Width="148" Margin="0,0,8,8"/><TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,8,8"/><DatePicker SelectedDate="{Binding End}" Width="148" Margin="0,0,16,8"/><CheckBox Content="包括初始库存、仓库与店面调拨、作废记录" IsChecked="{Binding Inventory}" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel Margin="0,0,0,14"><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="100" Margin="0,0,10,8"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Channel}" Width="100" Margin="0,0,10,8"><ComboBoxItem Content="全部"/><ComboBoxItem Content="厂家"/><ComboBoxItem Content="零售"/><ComboBoxItem Content="批发"/></ComboBox><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="100" Margin="0,0,10,8"/><TextBox Text="{Binding RecordSearch,UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" ToolTip="筛选货品名称或规格"/><Button Content="查询" p:Presentation.Icon="{StaticResource SearchIcon}" Style="{StaticResource Primary}" Click="Query" Margin="0,0,8,8"/><Button Content="组合筛选" Click="RecordFilter"/><Button Content="分类汇总" Click="RecordSummary"/><Button Content="导出 Excel" p:Presentation.Icon="{StaticResource ExportIcon}" Click="Export" Margin="0,0,8,8"/></WrapPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Click="PreviousPage" Padding="12,5"/><Button Content="下一页" Click="NextPage" Padding="12,5"/></StackPanel><TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding RetentionText}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
    <DataGrid ItemsSource="{Binding Records}" MouseDoubleClick="RecordDoubleClick" x:Name="RecordsGrid"><DataGrid.Columns><DataGridTextColumn Header="业务日期" Binding="{Binding Date}" Width="110" MinWidth="110"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" MinWidth="80"/><DataGridTextColumn Header="渠道" Binding="{Binding Channel}" Width="85" MinWidth="85"/><DataGridTextColumn Header="货品与数量" Binding="{Binding Items}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85" MinWidth="85"/><DataGridTemplateColumn Header="详情" Width="85" MinWidth="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="查看" Tag="{Binding}" Padding="8,4" MinHeight="30" Click="Details"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
