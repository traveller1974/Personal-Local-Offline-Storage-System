<Window x:Class="Stock.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="本地库存管理" Width="1180" Height="780" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="26,22">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地库存管理" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="看清库存，确认每一次进出。" Margin="0,6,0,0" Foreground="#688276"/></StackPanel><Button Grid.Column="1" Content="设置与备份" Click="Settings" VerticalAlignment="Center"/></Grid>
  <Border DockPanel.Dock="Bottom" Background="#E8F0ED" CornerRadius="5" Padding="14,10" Margin="0,16,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="v1.1.1 · 库存本机保存" Foreground="#628477"/><TextBlock Text="{Binding Notice}"/></DockPanel></Border>
  <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
   <TabItem Header="库存首页"><DockPanel Margin="16,20">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBox Width="220" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、规格或物料编码搜索"/><CheckBox Content="显示停用货品" IsChecked="{Binding IncludeInactive}" Margin="16,0"/><Button Content="＋ 新增货品" Style="{StaticResource Primary}" Click="CreateProduct"/><Button Content="组合筛选" Click="InventoryFilter"/><Button Content="汇总 / 展开" Click="InventorySummary"/><Button Content="导出库存" Click="InventoryExport"/><Button Content="刷新" Click="Refresh"/></WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="进出货只在仓库记账；资料待补全货品不能被云端识别自动关联。"/><WrapPanel><TextBlock Text="{Binding ProductPageText}" VerticalAlignment="Center"/><Button Content="上一页" Click="PreviousProducts"/><Button Content="下一页" Click="NextProducts"/></WrapPanel></StackPanel>
    <Grid><DataGrid ItemsSource="{Binding Products}" x:Name="InventoryGrid"><DataGrid.Columns>
     <DataGridTextColumn Header="货品名称" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="130"/>
     <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="75"/>
     <DataGridTextColumn Header="颜色" Binding="{Binding ColorText}" Width="100"/>
     <DataGridTextColumn Header="物料编码" Binding="{Binding MaterialCode}" Width="110"/>
     <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65"/>
     <DataGridTextColumn Header="店面" Binding="{Binding Store}" Width="95"/>
     <DataGridTextColumn Header="仓库" Binding="{Binding Warehouse}" Width="95"/>
     <DataGridTextColumn Header="合计" Binding="{Binding Total}" Width="95"/>
     <DataGridTemplateColumn Header="操作" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="调整分布" Tag="{Binding}" Padding="10,4" MinHeight="30" Click="Transfer"/><Button Content="编辑" Tag="{Binding}" Padding="10,4" MinHeight="30" Click="EditProduct"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid><TextBlock Text="还没有货品。点击“新增货品”录入名称、规格与期初库存。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#728477"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Products.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   </DockPanel></TabItem>
   <TabItem Header="进货"><StackPanel Margin="30,36"><TextBlock Text="厂家进货" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="手动添加货品，或导入货单照片。核对清单并最终确认后，数量增加到仓库。" TextWrapping="Wrap" Margin="0,14,0,26"/><WrapPanel><Button Content="手动进货" Style="{StaticResource Primary}" Click="Purchase"/><Button Content="照片识别进货" Click="PhotoPurchase"/></WrapPanel><Border Background="White" Padding="22" Margin="0,34,0,0" CornerRadius="6"><StackPanel><TextBlock Text="货单照片使用步骤" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="1. 将手机照片复制到电脑，或使用电脑摄像头拍照。&#xA;2. 对照照片逐行确认货品与整数数量。&#xA;3. 查看仓库变更前后数量，再确认入库。" LineHeight="30" Margin="0,12,0,0"/><TextBlock Text="仅上传用户确认的表格截图到百炼；手工业务可断网使用。" Foreground="#087F73" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></TabItem>
   <TabItem Header="出货"><StackPanel Margin="30,36"><TextBlock Text="零售与批发出货" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="选择出货渠道，手动添加货品并核对数量。最终确认后，只从仓库扣减。" TextWrapping="Wrap" Margin="0,14,0,26"/><Button Content="新增出货单" Style="{StaticResource Primary}" Click="Sale" HorizontalAlignment="Left"/><Border Background="White" Padding="22" Margin="0,34,0,0" CornerRadius="6"><TextBlock Text="仓库不足时，请先在库存首页调整店面与仓库分布，然后重新出货。" TextWrapping="Wrap"/></Border></StackPanel></TabItem>
   <TabItem Header="记录查询"><DockPanel Margin="16,20">
    <StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,0,0,12"><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="140" Margin="0,0,12,8"/><DatePicker SelectedDate="{Binding Start}" Width="148" Margin="0,0,8,8"/><TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,8,8"/><DatePicker SelectedDate="{Binding End}" Width="148" Margin="0,0,16,8"/><CheckBox Content="库存变动记录（含期初、调拨和作废反向）" IsChecked="{Binding Inventory}" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel Margin="0,0,0,14"><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="100" Margin="0,0,10,8"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Channel}" Width="100" Margin="0,0,10,8"><ComboBoxItem Content="全部"/><ComboBoxItem Content="厂家"/><ComboBoxItem Content="零售"/><ComboBoxItem Content="批发"/></ComboBox><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="100" Margin="0,0,10,8"/><TextBox Text="{Binding RecordSearch,UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" ToolTip="筛选货品名称或规格"/><Button Content="查询" Style="{StaticResource Primary}" Click="Query" Margin="0,0,8,8"/><Button Content="组合筛选" Click="RecordFilter"/><Button Content="汇总 / 展开" Click="RecordSummary"/><Button Content="导出 Excel" Click="Export" Margin="0,0,8,8"/></WrapPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Click="PreviousPage" Padding="12,5"/><Button Content="下一页" Click="NextPage" Padding="12,5"/></StackPanel><TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding RetentionText}" Foreground="#728477" Margin="0,10,0,0"/></StackPanel>
    <DataGrid ItemsSource="{Binding Records}" MouseDoubleClick="RecordDoubleClick" x:Name="RecordsGrid"><DataGrid.Columns><DataGridTextColumn Header="业务日期" Binding="{Binding Date}" Width="110"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="渠道" Binding="{Binding Channel}" Width="85"/><DataGridTextColumn Header="货品与数量" Binding="{Binding Items}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85"/><DataGridTemplateColumn Header="详情" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="查看" Tag="{Binding}" Padding="8,4" MinHeight="30" Click="Details"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
