<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained><AssemblyName>LocalStockManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseEmbeddedRecognition Condition="'$(UseEmbeddedRecognition)' == ''">false</UseEmbeddedRecognition>
    <RecognitionWorkerExe>$(MSBuildThisFileDirectory)../../artifacts/recognition-lab/single-file/Stock.RecognitionLab.exe</RecognitionWorkerExe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Stock.RecognitionLab/DetailImagePreparation.cs" Link="DetailImagePreparation.cs" />
    <ProjectReference Include="../Stock.Core/Stock.Core.csproj" />
    <ProjectReference Include="../Stock.Recognition/Stock.Recognition.csproj" />
    <EmbeddedResource Include="$(RecognitionWorkerExe)" LogicalName="Stock.Desktop.Recognition.Stock.RecognitionLab.exe" />
    <RuntimeHostConfigurationOption Include="LocalStockManager.UseEmbeddedRecognition" Value="$(UseEmbeddedRecognition)" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>
  <Target Name="RequireRecognitionWorker" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RecognitionWorkerExe)')" Text="请先运行 scripts/build_recognition_lab.ps1，生成要内置的识图 EXE。" />
  </Target>
</Project>
