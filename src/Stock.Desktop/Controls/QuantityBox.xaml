<UserControl x:Class="Stock.Desktop.Controls.QuantityBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="170">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
  <Button x:Name="Minus" Content="−" Padding="0" Margin="0" Click="Decrease" ToolTip="减1"/>
  <TextBox x:Name="Input" Grid.Column="1" TextAlignment="Center" MaxLength="12" Padding="4,7" TextChanged="InputChanged" PreviewTextInput="Typed" DataObject.Pasting="Pasted" ToolTip="点数字直接修改，只能填写整数"/>
  <Button x:Name="Plus" Grid.Column="2" Content="＋" Padding="0" Margin="0" Click="Increase" ToolTip="加1"/>
 </Grid>
</UserControl>
