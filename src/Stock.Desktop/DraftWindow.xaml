<Window x:Class="Stock.Desktop.DraftWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:q="clr-namespace:Stock.Desktop.Controls" Style="{StaticResource {x:Type Window}}" Width="1000" Height="690" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="26"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="编辑清单后查看确认页；最终确认之前，库存数量不会改变。" Margin="0,0,0,18"/>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="渠道：" VerticalAlignment="Center"/><TextBlock x:Name="Manufacturer" Text="厂家" VerticalAlignment="Center"/><ComboBox x:Name="SaleChannel" Width="160" SelectedValuePath="Content" SelectionChanged="ChannelChanged"><ComboBoxItem Content="零售"/><ComboBoxItem Content="批发"/></ComboBox><Button x:Name="OcrButton" Content="导入照片 / 摄像头" Click="Ocr" Margin="28,0,0,0"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><ComboBox x:Name="ProductPicker" Width="370" DisplayMemberPath="Display" IsEditable="True" IsTextSearchEnabled="True"/><q:QuantityBox x:Name="AddQuantity" Width="180" Margin="12,0,12,0"/><Button Content="添加到清单" Style="{StaticResource Primary}" Click="Add"/></StackPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="PhotosNotice" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel"/><Button x:Name="PreviewButton" Content="查看确认页" Click="Preview" Style="{StaticResource Primary}"/></StackPanel></StackPanel>
  <DataGrid ItemsSource="{Binding Lines}" RowHeight="60"><DataGrid.Columns><DataGridTextColumn Header="货品名称" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="规格" Binding="{Binding Product.Spec}" Width="140"/><DataGridTextColumn Header="单位" Binding="{Binding Product.Unit}" Width="70"/><DataGridTemplateColumn Header="数量" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><q:QuantityBox Value="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="移除" Tag="{Binding}" Click="Remove" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
