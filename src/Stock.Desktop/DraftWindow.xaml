<Window x:Class="Stock.Desktop.DraftWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:q="clr-namespace:Stock.Desktop.Controls" Style="{StaticResource {x:Type Window}}" Width="1000" Height="690" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="26"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="在数量框中直接输入，或点－和＋修改。“已核对”可用于标记检查过的行。最后查看确认页并确认入库或出库。" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="渠道：" VerticalAlignment="Center"/><TextBlock x:Name="Manufacturer" Text="厂家" VerticalAlignment="Center"/><ComboBox x:Name="SaleChannel" Width="160" SelectedValuePath="Content" SelectionChanged="ChannelChanged"><ComboBoxItem Content="零售"/><ComboBoxItem Content="批发"/></ComboBox><Button x:Name="OcrButton" Content="导入照片 / 摄像头" Click="Ocr" Margin="28,0,0,0"/></StackPanel>
  <WrapPanel Margin="0,0,0,12"><TextBox x:Name="ProductSearch" Width="180" ToolTip="输入货品名称、规格或编码后，点击搜索货品"/><Button Content="搜索货品" Click="SearchProducts"/><Button Content="组合筛选" Click="FilterProducts"/><Button Content="上一页" Click="PreviousProducts"/><Button Content="下一页" Click="NextProducts"/></WrapPanel><WrapPanel Margin="0,0,0,18"><ComboBox x:Name="ProductPicker" Width="370" DisplayMemberPath="Display" IsEditable="True" IsTextSearchEnabled="True"/><q:QuantityBox x:Name="AddQuantity" Width="180" Margin="12,0,12,0"/><Button Content="添加到清单" Style="{StaticResource Primary}" Click="Add"/><Button x:Name="NewProductButton" Content="新建货品" Click="NewProduct"/></WrapPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="PhotosNotice" Margin="0,0,0,10"/><TextBlock Text="数量说明（可留空）" Margin="0,0,0,5"/><TextBox Text="{Binding TotalCorrection,UpdateSourceTrigger=PropertyChanged}" ToolTip="需要时记录数量调整说明" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel"/><Button x:Name="PreviewButton" Content="查看确认页" Click="Preview" Style="{StaticResource Primary}"/></StackPanel></StackPanel>
  <DataGrid x:Name="DraftGrid" ItemsSource="{Binding Lines}" RowHeight="60"><DataGrid.Columns><DataGridTextColumn Header="货品名称" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="规格" Binding="{Binding Product.Spec}" Width="140"/><DataGridTextColumn Header="类型" Binding="{Binding Product.TypeText}" Width="70"/><DataGridTextColumn Header="颜色" Binding="{Binding Product.ColorText}" Width="90"/><DataGridTextColumn Header="编码" Binding="{Binding Product.MaterialCode}" Width="100"/><DataGridTextColumn Header="标识" Binding="{Binding Marker}" Width="55"/><DataGridTextColumn Header="单位" Binding="{Binding Product.Unit}" Width="70"/><DataGridTemplateColumn Header="数量" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><q:QuantityBox Minimum="{Binding DataContext.QuantityMinimum,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="{Binding Quantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="已核对" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox x:Name="DraftReviewedCheck" IsChecked="{Binding Reviewed,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DraftReviewClicked" ToolTip="可用于标记检查过的行，不影响最终确认"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="移除" Tag="{Binding}" Click="Remove" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
