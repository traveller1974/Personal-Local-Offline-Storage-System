<Window x:Class="Stock.RecognitionLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="千问图像识别 · 独立测试" Width="1360" Height="900" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Dropped" DragOver="Dragged">
 <Grid x:Name="Root" Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="千问图像识别测试" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="先看原始输出，再对照完整字段，最后核对样单差异。" Foreground="#59766E" Margin="0,4,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#DFEEE8" CornerRadius="5" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="独立测试 · 不连接库存" Foreground="#087F73"/></Border>
  </Grid>
  <Expander x:Name="ConnectionSettings" Grid.Row="1" Header="千问连接配置（仅本次会话使用）" IsExpanded="True" Margin="0,0,0,12">
   <Border Background="White" Padding="12" BorderBrush="#D5E2DE" BorderThickness="1"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="API Key" Margin="0,0,0,4"/><PasswordBox x:Name="ApiKeyBox"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="业务空间（可选）" Margin="0,0,0,4"/><TextBox x:Name="WorkspaceBox"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"><TextBlock Text="所属地域的原生 DashScope 服务地址 · qwen3.5-ocr" Margin="0,0,0,4"/><TextBox x:Name="EndpointBox" Text="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"/></StackPanel>
   </Grid></Border>
  </Expander>
  <StackPanel x:Name="ImageToolbar" Grid.Row="2" Margin="0,0,0,10">
   <WrapPanel><Button Content="选择图片" Click="Choose"/><ComboBox x:Name="SamplePicker" Width="155" Margin="0,0,8,6" SelectionChanged="SampleChanged"/><Button Content="打开选中样单" Click="OpenSample"/><Button Content="向左旋转" Click="RotateLeft"/><Button Content="向右旋转" Click="RotateRight"/><Button x:Name="CropButton" Content="框选裁剪" Click="EnableCrop"/><Button Content="恢复原图" Click="Reset"/><Button Content="适应图片区域" Click="FitImage"/></WrapPanel>
   <WrapPanel><CheckBox x:Name="UploadConfirm" Content="已确认显示截图仅含表头、明细和合计，允许上传百炼" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="Zoom" Minimum="0.02" Maximum="3" Value="0.5" Width="120" VerticalAlignment="Center" ValueChanged="Zoomed"/></WrapPanel>
  </StackPanel>
  <Grid x:Name="ContentGrid" Grid.Row="3" SizeChanged="ContentAreaChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <Grid x:Name="ImagePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="ImageCaption" Text="选择或拖入一张图片，框选表格后测试。" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#59766E"/>
    <Border Grid.Row="1" Background="#E4ECE7" CornerRadius="6"><ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ImageAreaChanged">
     <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="CropStart" MouseMove="CropMove" MouseLeftButtonUp="CropEnd" LostMouseCapture="CropCaptureLost">
      <Image x:Name="PhotoImage" Stretch="Fill"/><Canvas IsHitTestVisible="False"><Rectangle x:Name="Selection" Stroke="#E58B34" StrokeThickness="2" Fill="#35E58B34" Visibility="Collapsed"/></Canvas>
     </Grid>
    </ScrollViewer></Border>
   </Grid>
   <TabControl x:Name="ResultTabs" Grid.Column="2">
    <TabItem Header="识别字段"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SummaryScroller" MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8"><StackPanel>
      <TextBlock x:Name="ResultSummary" Text="识别后会显示全部行级字段和单据合计。" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <ItemsControl x:Name="TotalsList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="#A45D16" Margin="0,8,0,0"/>
     </StackPanel></ScrollViewer>
     <ListBox x:Name="RowsList" Grid.Row="1" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D5E2DE" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10"><StackPanel>
       <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="#59766E" VerticalAlignment="Top" Margin="0,3,8,0"/><TextBox Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ReadOnlyValue}"/>
       </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid></TabItem>
    <TabItem Header="原始输出"><TabControl Margin="8">
     <TabItem Header="模型原文"><TextBox x:Name="ModelTextBox" Style="{StaticResource RawText}"/></TabItem>
     <TabItem Header="服务响应"><TextBox x:Name="ResponseBox" Style="{StaticResource RawText}"/></TabItem>
     <TabItem Header="解析结果"><TextBox x:Name="ParsedBox" Style="{StaticResource RawText}"/></TabItem>
    </TabControl></TabItem>
    <TabItem Header="样单对比与意见"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
     <TextBlock x:Name="ComparisonSummary" Text="选中对应样单后，会将识别结果与人工基准逐字段比较。" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="PendingText" TextWrapping="Wrap" Foreground="#A45D16" Margin="0,0,0,12"/>
     <TextBlock Text="人工核对意见（与识别值分开保存）" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <ComboBox x:Name="ReviewDecision" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="待核对"/><ComboBoxItem Content="需要修正后重测"/><ComboBoxItem Content="本次结果已人工核对通过"/></ComboBox>
     <TextBox x:Name="ReviewNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
     <ItemsControl x:Name="DifferenceList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E5D9C8" BorderThickness="1" Padding="10" Margin="0,0,0,8"><StackPanel>
      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="StatusText" Text="填写连接配置并确认截图后，主动点击识别。每次点击最多发送一次请求。" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <WrapPanel Grid.Row="1" HorizontalAlignment="Right"><Button x:Name="ReplayButton" Content="载入本地响应" Click="Replay"/><Button x:Name="ExportButton" Content="导出结果与核对意见" Click="Export" IsEnabled="False"/><Button x:Name="CancelButton" Content="取消识别" Click="Cancel" Visibility="Collapsed"/><Button x:Name="RecognizeButton" Content="识别确认的截图" Style="{StaticResource Primary}" Click="Recognize"/></WrapPanel>
  </Grid>
 </Grid>
</Window>
